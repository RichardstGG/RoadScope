{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.roadscope.invalid/motion-lean/v2/lean.schema.json",
  "title": "RoadScope derived lean log record, schemaVersion 2",
  "description": "One NDJSON line of the derived lean log (calibrations, estimates, per-segment extrema). See contracts/motion-lean/v2/README.md for the normative text.",
  "oneOf": [
    {
      "$ref": "#/$defs/leanCalibration"
    },
    {
      "$ref": "#/$defs/leanEstimate"
    },
    {
      "$ref": "#/$defs/leanExtremum"
    },
    {
      "$ref": "#/$defs/leanSegmentClosed"
    },
    {
      "$ref": "#/$defs/leanEvent"
    },
    {
      "$ref": "#/$defs/leanHint"
    }
  ],
  "$defs": {
    "leanRecordBase": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "recordingId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "sourceId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "deviceBootId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "sequence": {
          "$ref": "common.schema.json#/$defs/sequence"
        },
        "qualityFlags": {
          "$ref": "common.schema.json#/$defs/qualityFlags"
        },
        "leanRunId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString",
          "description": "Identifier of the lean run (one lean file holds exactly one run). Every line carries it."
        }
      },
      "required": [
        "schemaVersion",
        "recordingId",
        "sourceId",
        "deviceBootId",
        "sequence",
        "qualityFlags",
        "leanRunId"
      ]
    },
    "calibrationEvidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "manual_rest"
            },
            "restDurationUs": {
              "type": "integer",
              "minimum": 1
            },
            "upSpreadDeg": {
              "type": "number",
              "minimum": 0
            },
            "sourceRange": {
              "$ref": "common.schema.json#/$defs/monotonicRange"
            }
          },
          "required": [
            "kind",
            "restDurationUs",
            "upSpreadDeg",
            "sourceRange"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "auto_straight"
            },
            "accumulatedDurationUs": {
              "type": "integer",
              "minimum": 1
            },
            "windowCount": {
              "type": "integer",
              "minimum": 1
            },
            "minSpeedMps": {
              "type": "number",
              "minimum": 0
            },
            "maxYawRateRadPerS": {
              "type": "number",
              "minimum": 0
            },
            "upSpreadDeg": {
              "type": "number",
              "minimum": 0
            },
            "sourceRange": {
              "$ref": "common.schema.json#/$defs/monotonicRange"
            },
            "hintRange": {
              "type": "object",
              "properties": {
                "firstHintSequence": {
                  "$ref": "common.schema.json#/$defs/sequence"
                },
                "lastHintSequence": {
                  "$ref": "common.schema.json#/$defs/sequence"
                }
              },
              "required": [
                "firstHintSequence",
                "lastHintSequence"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "accumulatedDurationUs",
            "windowCount",
            "minSpeedMps",
            "maxYawRateRadPerS",
            "upSpreadDeg",
            "sourceRange",
            "hintRange"
          ],
          "additionalProperties": false
        }
      ]
    },
    "leftLeanConfirmation": {
      "type": "object",
      "properties": {
        "peakLeanMagnitudeDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "durationUs": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRange": {
          "$ref": "common.schema.json#/$defs/monotonicRange"
        }
      },
      "required": [
        "peakLeanMagnitudeDeg",
        "durationUs",
        "sourceRange"
      ],
      "additionalProperties": false
    },
    "leanCalibration": {
      "properties": {
        "recordType": {
          "const": "lean_calibration"
        },
        "calibrationId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "supersedesCalibrationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "origin": {
          "enum": [
            "manual_upright",
            "auto_straight_ride",
            "carried_over"
          ]
        },
        "effectiveFromMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "writtenMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "upDevice": {
          "$ref": "common.schema.json#/$defs/unitVector3"
        },
        "leanAxisDevice": {
          "$ref": "common.schema.json#/$defs/unitVector3"
        },
        "leanAxisSource": {
          "type": "string",
          "minLength": 1
        },
        "leftLeanConfirmation": {
          "oneOf": [
            {
              "$ref": "#/$defs/leftLeanConfirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/calibrationEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "carriedOverFromCalibrationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "algorithmVersion": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "required": [
        "recordType",
        "calibrationId",
        "supersedesCalibrationId",
        "origin",
        "effectiveFromMonotonicUs",
        "writtenMonotonicUs",
        "upDevice",
        "leanAxisDevice",
        "leanAxisSource",
        "leftLeanConfirmation",
        "evidence",
        "carriedOverFromCalibrationId",
        "algorithmVersion"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/leanRecordBase"
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "manual_upright"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "manual_rest"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "auto_straight_ride"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "auto_straight"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "const": "carried_over"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "type": "null"
              },
              "carriedOverFromCalibrationId": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "carriedOverFromCalibrationId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "leanAxisSource": {
                "const": "manual_left_lean"
              }
            }
          },
          "then": {
            "properties": {
              "leftLeanConfirmation": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "leftLeanConfirmation": {
                "type": "null"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "sourceId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "firstSequence": {
          "$ref": "common.schema.json#/$defs/sequence"
        },
        "lastSequence": {
          "$ref": "common.schema.json#/$defs/sequence"
        }
      },
      "required": [
        "sourceId",
        "firstSequence",
        "lastSequence"
      ],
      "additionalProperties": false
    },
    "leanEstimate": {
      "allOf": [
        {
          "$ref": "#/$defs/leanRecordBase"
        }
      ],
      "properties": {
        "recordType": {
          "const": "lean_estimate"
        },
        "measurementMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "computedMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "leanAngleDeg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "calibrationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "algorithmVersion": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "clockMapId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "extremumEligible": {
          "type": "boolean"
        },
        "filterEpoch": {
          "type": "integer",
          "minimum": 0,
          "description": "Fusion-state epoch: the number of the latest estimator_reset. The estimate depends on inputs from that reset's initialInputs onward, not only on sourceRefs."
        },
        "motionControlCursor": {
          "type": "integer",
          "minimum": -1,
          "description": "Highest motion_event.controlSequence consumed: the last event before the newest input sample in the motion file, -1 when none."
        }
      },
      "required": [
        "recordType",
        "filterEpoch",
        "measurementMonotonicUs",
        "computedMonotonicUs",
        "leanAngleDeg",
        "calibrationId",
        "algorithmVersion",
        "sourceRefs",
        "clockMapId",
        "extremumEligible",
        "motionControlCursor"
      ],
      "unevaluatedProperties": false
    },
    "leanExtremum": {
      "allOf": [
        {
          "$ref": "#/$defs/leanRecordBase"
        }
      ],
      "properties": {
        "recordType": {
          "const": "lean_extremum"
        },
        "calibrationId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "peakAbsAngleDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "eventMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "estimateSequence": {
          "$ref": "common.schema.json#/$defs/sequence"
        },
        "windowStartMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "windowEndMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "policyVersion": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      },
      "required": [
        "recordType",
        "calibrationId",
        "side",
        "peakAbsAngleDeg",
        "eventMonotonicUs",
        "estimateSequence",
        "windowStartMonotonicUs",
        "windowEndMonotonicUs",
        "policyVersion"
      ],
      "unevaluatedProperties": false
    },
    "segmentExtremum": {
      "type": "object",
      "properties": {
        "peakAbsAngleDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "eventMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "extremumSequence": {
          "$ref": "common.schema.json#/$defs/sequence"
        }
      },
      "required": [
        "peakAbsAngleDeg",
        "eventMonotonicUs",
        "extremumSequence"
      ],
      "additionalProperties": false
    },
    "leanSegmentClosed": {
      "allOf": [
        {
          "$ref": "#/$defs/leanRecordBase"
        }
      ],
      "properties": {
        "recordType": {
          "const": "lean_segment_closed"
        },
        "calibrationId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "closedAtMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "closeReason": {
          "enum": [
            "recalibrated",
            "calibration_invalidated",
            "recording_stopped",
            "boot_changed",
            "recording_interrupted"
          ]
        },
        "maxLeft": {
          "oneOf": [
            {
              "$ref": "#/$defs/segmentExtremum"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxRight": {
          "oneOf": [
            {
              "$ref": "#/$defs/segmentExtremum"
            },
            {
              "type": "null"
            }
          ]
        },
        "eligibleEstimateCount": {
          "type": "integer",
          "minimum": 0
        },
        "ineligibleEstimateCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "recordType",
        "calibrationId",
        "closedAtMonotonicUs",
        "closeReason",
        "maxLeft",
        "maxRight",
        "eligibleEstimateCount",
        "ineligibleEstimateCount"
      ],
      "unevaluatedProperties": false
    },
    "leanEventBase": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "recordType": {
          "const": "lean_event"
        },
        "eventType": {
          "type": "string"
        },
        "recordingId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "sourceId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "deviceBootId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "occurredAtUtc": {
          "$ref": "common.schema.json#/$defs/utcTimestamp"
        },
        "occurredMonotonicUs": {
          "$ref": "common.schema.json#/$defs/monotonicUs"
        },
        "leanRunId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString",
          "description": "Identifier of the lean run (one lean file holds exactly one run). Every line carries it."
        },
        "lastSequences": {
          "type": "object",
          "description": "sourceId -> last sequence written for that stream before this event, -1 when none yet.",
          "additionalProperties": {
            "type": "integer",
            "minimum": -1
          }
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "eventType",
        "recordingId",
        "sourceId",
        "deviceBootId",
        "occurredAtUtc",
        "occurredMonotonicUs",
        "leanRunId",
        "lastSequences"
      ]
    },
    "leanEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/eventLeanStarted"
        },
        {
          "$ref": "#/$defs/eventCalibrationInvalidated"
        },
        {
          "$ref": "#/$defs/eventEstimatorReset"
        },
        {
          "$ref": "#/$defs/eventEstimatorState"
        },
        {
          "$ref": "#/$defs/eventRecordsDropped"
        },
        {
          "$ref": "#/$defs/eventClockAdjusted"
        },
        {
          "$ref": "#/$defs/eventLogTruncated"
        },
        {
          "$ref": "#/$defs/eventRecordingResumed"
        },
        {
          "$ref": "#/$defs/eventAutoReferenceReset"
        },
        {
          "$ref": "#/$defs/eventAutoReferenceState"
        }
      ]
    },
    "eventLeanStarted": {
      "allOf": [
        {
          "$ref": "#/$defs/leanEventBase"
        }
      ],
      "properties": {
        "eventType": {
          "const": "lean_started"
        },
        "platform": {
          "$ref": "common.schema.json#/$defs/platform"
        },
        "appVersion": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "algorithmVersion": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "maxInputGapUs": {
          "type": "integer",
          "minimum": 1
        },
        "replayable": {
          "type": "boolean",
          "description": "true: every non-null estimate can be replayed from its epoch boundary using only stored, complete input (storageStride 1, no break inside an epoch). Verified by paired validation."
        },
        "extremumPolicy": {
          "type": "object",
          "properties": {
            "policyVersion": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "rule": {
              "enum": [
                "min_abs_in_same_side_window"
              ]
            },
            "minWindowUs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "policyVersion",
            "rule",
            "minWindowUs"
          ],
          "additionalProperties": false
        },
        "inputSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "stream": {
                "enum": [
                  "motion"
                ]
              }
            },
            "required": [
              "sourceId",
              "stream"
            ],
            "additionalProperties": false
          }
        },
        "inputConsumption": {
          "enum": [
            "stored_only"
          ]
        },
        "replayScope": {
          "type": "object",
          "properties": {
            "estimate": {
              "type": "boolean"
            },
            "calibration": {
              "type": "boolean"
            },
            "refilter": {
              "type": "boolean"
            }
          },
          "required": [
            "estimate",
            "calibration",
            "refilter"
          ],
          "additionalProperties": false
        },
        "autoReferenceConfigFingerprint": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256Hex"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "experimental",
                "qualified"
              ]
            },
            "qualificationRef": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "qualifiedConfiguration": {
              "oneOf": [
                {
                  "$ref": "#/$defs/qualifiedConfiguration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "configurationFingerprint": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/sha256Hex"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "qualificationRef",
            "qualifiedConfiguration",
            "configurationFingerprint"
          ],
          "additionalProperties": false
        },
        "derivesFrom": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "leanRunId": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "reason": {
                  "enum": [
                    "recompute",
                    "recovery_after_corruption",
                    "algorithm_upgrade"
                  ]
                },
                "parentByteLength": {
                  "type": "integer",
                  "minimum": 0
                },
                "parentPrefixSha256": {
                  "$ref": "common.schema.json#/$defs/sha256Hex"
                },
                "parentLastSequences": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": -1
                  }
                },
                "parentValidation": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "failed",
                        "passed",
                        "not_run"
                      ]
                    },
                    "errorCodes": {
                      "type": "array",
                      "items": {
                        "$ref": "common.schema.json#/$defs/nonEmptyString"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "errorCodes"
                  ],
                  "additionalProperties": false
                },
                "coverage": {
                  "type": "object",
                  "properties": {
                    "fromMonotonicUs": {
                      "$ref": "common.schema.json#/$defs/monotonicUs"
                    },
                    "toMonotonicUs": {
                      "$ref": "common.schema.json#/$defs/monotonicUs"
                    },
                    "complete": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "fromMonotonicUs",
                    "toMonotonicUs",
                    "complete"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "leanRunId",
                "reason",
                "parentByteLength",
                "parentPrefixSha256",
                "parentLastSequences",
                "parentValidation",
                "coverage"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "eventType",
        "platform",
        "appVersion",
        "algorithmVersion",
        "maxInputGapUs",
        "replayable",
        "extremumPolicy",
        "inputSources",
        "inputConsumption",
        "replayScope",
        "autoReferenceConfigFingerprint",
        "qualification",
        "derivesFrom"
      ],
      "unevaluatedProperties": false
    },
    "eventEstimatorReset": {
      "allOf": [
        {
          "$ref": "#/$defs/leanEventBase"
        }
      ],
      "properties": {
        "eventType": {
          "const": "estimator_reset"
        },
        "filterEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "start",
            "after_input_gap",
            "input_clock_state_change",
            "raw_write_failure",
            "boot_changed",
            "recovery"
          ]
        },
        "initialInputs": {
          "type": "array",
          "minItems": 1,
          "description": "Per input source, the first motion sequence the new epoch consumes. Replay starts here.",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "firstSequence": {
                "$ref": "common.schema.json#/$defs/sequence"
              }
            },
            "required": [
              "sourceId",
              "firstSequence"
            ],
            "additionalProperties": false
          }
        },
        "initialControlCursor": {
          "type": "integer",
          "minimum": -1
        }
      },
      "required": [
        "eventType",
        "filterEpoch",
        "reason",
        "initialInputs",
        "initialControlCursor"
      ],
      "unevaluatedProperties": false
    },
    "eventEstimatorState": {
      "allOf": [
        {
          "$ref": "#/$defs/leanEventBase"
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
