{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.roadscope.invalid/location-log/v1/record.schema.json",
  "title": "RoadScope native location log record, schemaVersion 1",
  "description": "One NDJSON line of a native append-only location log. See contracts/location-log/v1/README.md for the normative text contract; the schema cannot express every rule.",
  "oneOf": [
    {
      "$ref": "#/$defs/sample"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "utcTimestamp": {
      "type": "string",
      "description": "RFC3339 with a literal Z offset. Local-offset forms are rejected so that no consumer has to normalise.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "qualityFlag": {
      "type": "string",
      "description": "Known values are listed in the text contract. Unknown values are tolerated and must be preserved, never dropped and never treated as valid.",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sourceType": {
      "description": "Source kind of a positioning fix, not implementation and not provenance. Excludes OBD: this record requires WGS84 coordinates and OBD produces none (see VehicleSample). phone_gnss is a deprecated alias of phone_location accepted until the end of P1.",
      "enum": [
        "phone_location",
        "external_gnss",
        "phone_gnss"
      ]
    },
    "sample": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/nullFlagConsistency"
        }
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "sample"
        },
        "recordingId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceType": {
          "$ref": "#/$defs/sourceType"
        },
        "deviceBootId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "measuredAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "receivedAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "measurementMonotonicUs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Native monotonic measurement time, microseconds, including sleep. null means the source has no such clock; consumers must not substitute receivedMonotonicUs."
        },
        "receivedMonotonicUs": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic clock including device sleep (Android elapsedRealtime, iOS mach_continuous_time), microseconds."
        },
        "latDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lonDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeM": {
          "type": [
            "number",
            "null"
          ]
        },
        "speedMps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "headingDeg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "horizontalAccuracyM": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "speedAccuracyMps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "qualityFlags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualityFlag"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "recordingId",
        "sourceId",
        "sourceType",
        "deviceBootId",
        "sequence",
        "measuredAtUtc",
        "receivedAtUtc",
        "measurementMonotonicUs",
        "receivedMonotonicUs",
        "latDeg",
        "lonDeg",
        "altitudeM",
        "speedMps",
        "headingDeg",
        "horizontalAccuracyM",
        "speedAccuracyMps",
        "qualityFlags"
      ],
      "additionalProperties": false
    },
    "nullFlagConsistency": {
      "description": "A nullable measurement is null if and only if its matching *_unavailable flag is present. Both directions are enforced so a writer cannot drop the flag or keep a stale one.",
      "allOf": [
        {
          "if": {
            "required": [
              "speedMps"
            ],
            "properties": {
              "speedMps": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "speed_unavailable"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "qualityFlags"
            ],
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "speed_unavailable"
                }
              }
            }
          },
          "then": {
            "properties": {
              "speedMps": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "headingDeg"
            ],
            "properties": {
              "headingDeg": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "heading_unavailable"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "qualityFlags"
            ],
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "heading_unavailable"
                }
              }
            }
          },
          "then": {
            "properties": {
              "headingDeg": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "horizontalAccuracyM"
            ],
            "properties": {
              "horizontalAccuracyM": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "horizontal_accuracy_unavailable"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "qualityFlags"
            ],
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "horizontal_accuracy_unavailable"
                }
              }
            }
          },
          "then": {
            "properties": {
              "horizontalAccuracyM": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "speedAccuracyMps"
            ],
            "properties": {
              "speedAccuracyMps": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "speed_accuracy_unavailable"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "qualityFlags"
            ],
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "speed_accuracy_unavailable"
                }
              }
            }
          },
          "then": {
            "properties": {
              "speedAccuracyMps": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "altitudeM"
            ],
            "properties": {
              "altitudeM": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "altitude_unavailable"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "qualityFlags"
            ],
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "altitude_unavailable"
                }
              }
            }
          },
          "then": {
            "properties": {
              "altitudeM": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "measurementMonotonicUs"
            ],
            "properties": {
              "measurementMonotonicUs": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "measurement_monotonic_unavailable"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "qualityFlags"
            ],
            "properties": {
              "qualityFlags": {
                "contains": {
                  "const": "measurement_monotonic_unavailable"
                }
              }
            }
          },
          "then": {
            "properties": {
              "measurementMonotonicUs": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "event": {
      "description": "Events share the sample sequence space without consuming it: lastSequence names the last valid sample written before the event, or -1 when none exists yet.",
      "oneOf": [
        {
          "$ref": "#/$defs/eventRecordingStarted"
        },
        {
          "$ref": "#/$defs/eventClockAdjusted"
        },
        {
          "$ref": "#/$defs/eventLogTruncated"
        },
        {
          "$ref": "#/$defs/eventRecordingResumed"
        }
      ]
    },
    "eventBase": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "recordType": {
          "const": "event"
        },
        "eventType": {
          "type": "string"
        },
        "recordingId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "deviceBootId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "occurredAtUtc": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "occurredMonotonicUs": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic clock including device sleep, microseconds, in the same time domain and deviceBootId as the samples. Required because UTC is exactly the value under suspicion in a clock_adjusted event."
        },
        "lastSequence": {
          "type": "integer",
          "minimum": -1
        }
      },
      "required": [
        "schemaVersion",
        "recordType",
        "eventType",
        "recordingId",
        "sourceId",
        "deviceBootId",
        "occurredAtUtc",
        "occurredMonotonicUs",
        "lastSequence"
      ]
    },
    "sourceCapabilities": {
      "type": "object",
      "properties": {
        "measurementMonotonic": {
          "type": "boolean",
          "description": "false means every sample from this source carries measurementMonotonicUs null."
        },
        "monotonicIncludesSleep": {
          "type": "boolean",
          "description": "Must be true for a conforming v1 writer. Present so that non-conforming historical logs stay self-describing."
        }
      },
      "required": [
        "measurementMonotonic",
        "monotonicIncludesSleep"
      ],
      "additionalProperties": false
    },
    "eventRecordingStarted": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        }
      ],
      "properties": {
        "eventType": {
          "const": "recording_started"
        },
        "platform": {
          "enum": [
            "android",
            "ios"
          ]
        },
        "appVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceType": {
          "$ref": "#/$defs/sourceType"
        },
        "sourceCapabilities": {
          "$ref": "#/$defs/sourceCapabilities"
        },
        "bootAnchorUtcMs": {
          "type": "integer",
          "description": "Raw utcMillis - monotonicMillis anchor at start. Recorded so the data layer can re-derive boot identity when the writer's heuristic misfires."
        }
      },
      "required": [
        "eventType",
        "platform",
        "appVersion",
        "sourceType",
        "sourceCapabilities",
        "bootAnchorUtcMs"
      ],
      "unevaluatedProperties": false
    },
    "eventClockAdjusted": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        }
      ],
      "properties": {
        "eventType": {
          "const": "clock_adjusted"
        },
        "previousDeviceBootId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "previousBootAnchorUtcMs": {
          "type": "integer"
        },
        "bootAnchorUtcMs": {
          "type": "integer"
        },
        "thresholdMs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "eventType",
        "previousDeviceBootId",
        "previousBootAnchorUtcMs",
        "bootAnchorUtcMs",
        "thresholdMs"
      ],
      "unevaluatedProperties": false
    },
    "eventLogTruncated": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        }
      ],
      "properties": {
        "eventType": {
          "const": "log_truncated"
        },
        "truncatedBytes": {
          "type": "integer",
          "minimum": 1
        },
        "resumedSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "eventType",
        "truncatedBytes",
        "resumedSequence"
      ],
      "unevaluatedProperties": false
    },
    "eventRecordingResumed": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        }
      ],
      "properties": {
        "eventType": {
          "const": "recording_resumed"
        },
        "reason": {
          "enum": [
            "crash",
            "process_restart",
            "boot"
          ]
        },
        "resumedSequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "eventType",
        "reason",
        "resumedSequence"
      ],
      "unevaluatedProperties": false
    }
  }
}
